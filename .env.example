# ------------------------------------------------------------------------------
# Telegram Bots Configuration Template (.env.example)
# ------------------------------------------------------------------------------

# Bot 1: @Avniffanbasebot (Community & Welcome Bot)
TELEGRAM_BOT_TOKEN_1=
BOT1_ENABLED=true

# Bot 2: @avnifanbbot (Timed Video Message Bot)
TELEGRAM_BOT_TOKEN_2=
BOT2_ENABLED=true

# Bot 3: @avnifanbasepaybot (Payment & VIP Checkout Bot)
TELEGRAM_BOT_TOKEN_3=
BOT3_ENABLED=true

# Bot 4: @avnifanbaseprembot (Premium Subscribed Members Bot)
TELEGRAM_BOT_TOKEN_4=
BOT4_ENABLED=true

# Password for the web dashboard, its APIs and /setadmin. Set this before going online.
# Multi-client mode (npm run start:hub): 10+ characters, creates the "admin" account on first start.
# Bot tokens above are ignored there; each client enters their own in the browser.
ADMIN_PASSWORD=

PORT=3789
WEBHOOK_DOMAIN=
