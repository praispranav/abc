# Nginx configuration for Telegram Bots & Dashboard
# Place this in /etc/nginx/sites-available/telegram-bot
# and symlink to /etc/nginx/sites-enabled/

server {
    listen 80;
    server_name bot.yourdomain.com;

    # Redirect all HTTP traffic to HTTPS (required by Telegram Webhook)
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bot.yourdomain.com;

    # SSL Certificates (Managed via Certbot: sudo certbot --nginx -d bot.yourdomain.com)
    ssl_certificate /etc/letsencrypt/live/bot.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bot.yourdomain.com/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Max upload size (accommodates video uploads up to 100MB for Bot 2)
    client_max_body_size 100M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_cache_bypass $http_upgrade;
    }
}
